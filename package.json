{
  "name": "ai-chat-message-switcher",
  "version": "1.3.9",
  "description": "A simple plugin that lets you easily navigate through user or assistant messages using up and down buttons.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnBra/web-extension.git"
  },
  "scripts": {
    "build": "vite build",
    "dev": "nodemon",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:chatgpt": "playwright test tests/chatgpt.spec.ts",
    "test:claude": "playwright test tests/claude.spec.ts",
    "test:gemini": "playwright test tests/gemini.spec.ts",
    "test:with-auth": "playwright test --storage-state=auth.json",
    "test:recaptcha-examples": "playwright test tests/recaptcha-examples.spec.ts",
    "test:skip-captcha": "SKIP_RECAPTCHA=true playwright test",
    "test:aggressive-captcha": "RECAPTCHA_MODE=aggressive playwright test",
    "save-auth-state": "npx playwright chromium --user-data-dir=./user-data"
  },
  "type": "module",
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "postcss-prefix-selector": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable": "^3.0.5",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "webextension-polyfill": "^0.11.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0-beta.26",
    "@playwright/test": "^1.51.1",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/react-resizable": "^3.0.7",
    "@types/webextension-polyfill": "^0.10.7",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fs-extra": "^11.2.0",
    "nodemon": "^3.1.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
